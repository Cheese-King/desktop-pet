:root{font-family:"Microsoft YaHei","Segoe UI",sans-serif;color:#e9ede8;background:#131b19;font-size:14px;color-scheme:dark}*{box-sizing:border-box}body{margin:0}header{display:flex;align-items:center;gap:12px;padding:20px 26px;border-bottom:1px solid #2b3730;background:#19231f}header strong{font-size:19px;letter-spacing:2px}header span{font-size:12px;font-weight:400;color:#a3b5a8;letter-spacing:0;margin-left:8px}header p{margin:5px 0 0;font-size:11px;color:#9caf9f}.logo{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:#b6d7ac;color:#223927;font-size:22px}header button{margin-left:auto}main{max-width:760px;margin:auto;padding:24px}.hero{padding:10px 3px 24px}.eyebrow{font-size:10px;letter-spacing:2px;color:#a9c69d}h1{font-size:25px;font-weight:500;margin:14px 0 10px}.hero p{color:#a7b5aa;font-size:12px}.stats{display:flex;gap:48px;margin-top:25px}.stats div{display:flex;align-items:baseline;gap:9px}.stats b{font-size:27px;font-weight:500}.stats span{font-size:11px;color:#9bad9e}.card{border:1px solid #304035;border-radius:17px;background:#1b2620;padding:20px;margin-bottom:16px}.section-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}h2{font-size:14px;margin:0;font-weight:500}.tag{font-size:10px;background:#30432f;border-radius:20px;color:#c2d6ad;padding:4px 9px}input,textarea,select{font:inherit;color:#e2e9df;border:1px solid #405143;background:#141e18;border-radius:9px;padding:11px;outline:none}input:focus,textarea:focus,select:focus{border-color:#b6d7ac}textarea{display:block;width:100%;resize:vertical;line-height:1.7;margin-top:9px}input{width:100%}label{font-size:11px;color:#a9b7a9}button{font:inherit;font-size:12px;cursor:pointer;border:1px solid transparent;border-radius:9px;padding:10px 15px;background:#b9d7aa;color:#253525;font-weight:500;white-space:nowrap}button:hover{filter:brightness(1.1)}button:disabled{opacity:.5;cursor:wait}.quiet,.chips button{background:transparent;color:#c3d6b8;border-color:#45563f}.form-footer{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:12px 0}small,.muted{font-size:10px;color:#a3b2a1}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:17px}.chips button{font-size:10px;padding:6px 10px}#reply{font-size:12px;color:#c6d5be;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;background:#222f25;padding:13px;border-radius:9px;margin-bottom:0}.inline{display:flex;gap:8px;margin-bottom:12px}.task{display:flex;align-items:center;gap:10px;padding:13px 0;border-bottom:1px solid #304035}.task:last-child{border:0}.task input{width:16px;height:16px;accent-color:#b9d7aa;flex-shrink:0}.task .content{flex:1;min-width:0}.task .title{font-size:12px;overflow-wrap:anywhere;line-height:1.7}.task .complete{text-decoration:line-through;color:#83927e}.task small{display:block;margin-top:3px;overflow-wrap:anywhere}.task button{font-size:10px;padding:6px 8px;background:#2a3b2b;color:#c4d8b8}.task button.delete{background:transparent;color:#c5a39b}.log{display:flex;gap:12px;padding:11px 0;border-bottom:1px solid #304035;font-size:11px}.log:last-child{border:0}.dot{color:#b4d89f}.dot.error{color:#e9af9d}.log div{flex:1;min-width:0;overflow-wrap:anywhere}.log small{display:block;margin-top:5px}.log time{font-size:10px;color:#9bab96}.empty{font-size:12px;text-align:center;padding:25px 10px;color:#98aa94}#plan-form textarea{margin-bottom:12px}select{font-size:10px;padding:5px 8px}footer{text-align:center;font-size:10px;color:#82927c;padding:7px 0 18px}@media(max-width:480px){main{padding:16px}header{padding:16px}.card{padding:15px}.stats{gap:22px}h1{font-size:22px}.task{flex-wrap:wrap}.form-footer small{max-width:180px}}
